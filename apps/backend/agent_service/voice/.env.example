# Voice sidecar (feat/voice-agent) env vars.
#
# Nothing in the main app's own .env needs to change for this feature
# -- these are additive, read only by voice/config.py and
# voice/bench/latency_bench.py.

# Master switch. When false (or unset), voice/router.py is never even
# imported by main.py, let alone mounted -- confirmed empirically
# (2026-08-11): app.openapi()["paths"] contains zero /voice/tools/*
# entries with this unset, and both tool paths with it set to "true".
VOICE_ENABLED=false

# Base URL of the main app's OWN public API -- the adapter calls this
# exactly like the browser frontend does, same guest-trial auth path,
# no direct DB access. Defaults to localhost for local dev.
AGENT_API_BASE_URL=http://localhost:8001

# Only used by voice/bench/latency_bench.py (a standalone script, no
# app dependencies) to call ElevenLabs' TTS API directly and measure
# real time-to-first-byte. The webhook flow itself (voice/router.py,
# voice/adapter.py) never calls ElevenLabs at all -- ElevenLabs calls
# INTO this app's webhooks, not the other way around.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
